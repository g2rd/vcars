# Skopiuj do .env.local i uzupełnij. Strona działa bez żadnych zmiennych (tryb demo, dane z pliku,
# indeksowanie wyłączone), ale PANEL ADMINISTRACYJNY wymaga bazy (DATABASE_URL).

# Publiczny adres serwisu (canonical, sitemap, JSON-LD, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indeksowanie przez wyszukiwarki. Włącz dopiero po uzupełnieniu config/site.ts
# i ustawieniu isDemo: false (inaczej build zakończy się błędem).
ALLOW_INDEXING=false

# Postgres. Poniżej baza lokalna z `npm run db:local` (bez Dockera).
# Z Dockerem (docker-compose.yml): postgres://vcars:vcars@localhost:5432/vcars
DATABASE_URL=postgres://vcars:vcars@localhost:5433/vcars

# Katalog na zdjęcia wgrywane z panelu (na produkcji: trwały dysk lub wolumen).
MEDIA_DIR=.data/media

# PWA (instalacja panelu na telefonie: manifest + service worker) to późniejszy etap.
# Zostaw "false", dopóki klient nie zamówi tej funkcji.
ENABLE_PWA=false

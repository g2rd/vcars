# Skopiuj do .env.local i uzupełnij. Wszystkie zmienne są opcjonalne – bez nich
# aplikacja działa w trybie demo (dane z pliku, indeksowanie wyłączone).

# Publiczny adres serwisu (canonical, sitemap, JSON-LD, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indeksowanie przez wyszukiwarki. Włącz dopiero po uzupełnieniu config/site.ts
# i ustawieniu isDemo: false (inaczej build zakończy się błędem).
ALLOW_INDEXING=false

# Postgres (pasuje do docker-compose.yml). Bez tej zmiennej: tryb demo.
DATABASE_URL=postgres://vcars:vcars@localhost:5432/vcars
